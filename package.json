    "pg": "^8.21.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1",
    "react-qr-code": "^2.0.21",
    "react-resizable-panels": "^4.11.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vaul": "^1.1.2",
    "vinxi": "^0.5.11",
    "xstate": "^5.31.1",
