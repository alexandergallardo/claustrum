    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.22.1",
    "postgres": "^3.4.9",
    "rolldown": "^1.0.2",
    "simple-git-hooks": "^2.13.1",
    "supabase": "^2.101.0",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "web-vitals": "^5.2.0",
    "wrangler": "^4.107.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{yaml,yml,css,html}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.1.3",
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "GHSA-pw9m-5jxm-xr6h"
      ]
    }
  }
}
