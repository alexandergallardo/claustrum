{
  "name": "horarios",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:web & pnpm run dev:api",
    "dev:web": "vite dev --port 3000",
    "dev:api": "pnpm --filter claustrum-api dev",
    "build": "fumadocs-mdx && tsc && vite build",
    "preview": "wrangler dev",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "simple-git-hooks",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:migrate-dev": "supabase migration up",
    "supabase:migrate-prod": "supabase migration up --linked",
    "auth:schema": "pnpm --filter claustrum-api exec better-auth generate --config src/auth-cli.ts --output ../../supabase/migrations/0076_better_auth_schema.sql --yes",
    "auth:migrate-users": "tsx scripts/migrate-supabase-auth-to-better-auth.ts"
  },
  "dependencies": {
