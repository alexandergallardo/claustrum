    "@types/mdx": "^2.0.13",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "beautiful-mermaid": "^1.1.3",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "framer-motion": "^12.40.0",
    "fumadocs-core": "^16.9.1",
    "fumadocs-mdx": "^15.0.8",
