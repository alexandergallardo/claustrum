{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claustrum-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "EVALUATIONS_BUCKET",
      "bucket_name": "claustrum-evaluations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
