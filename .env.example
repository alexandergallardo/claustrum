# -----------------------------------------------------------------------------
# Supabase - Environment Variables Template
#
# This repo uses a single Supabase base URL for the client app:
# - VITE_SUPABASE_URL
# plus a publishable (public) API key:
# - VITE_SUPABASE_PUBLISHABLE_KEY
#
# For privileged server-side operations (seed/admin scripts ONLY), use:
# - SUPABASE_SECRET_KEY
#
# How to use:
# - Copy this file to `.env.local` for local dev
# - For production, set env vars in your deployment platform (Cloudflare Pages)
# -----------------------------------------------------------------------------

# Supabase Project URL (base URL, NO /rest/v1 suffix)
# Local example:  http://127.0.0.1:54321
# Hosted example: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key (safe to expose publicly)
# Format: sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secret key (SERVER-ONLY, elevated privileges)
# Format: sb_secret_...
# WARNING: DO NOT expose publicly. DO NOT embed in client code.
# Used ONLY for: supabase/scripts/seed.ts and admin operations
SUPABASE_SECRET_KEY=
